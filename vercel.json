{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; img-src 'self' data:; base-uri 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "functions": {
    "api/sales-agent.mjs": {
      "maxDuration": 180
    },
    "api/outlook.mjs": {
      "maxDuration": 30
    },
    "api/outlook-callback.mjs": {
      "maxDuration": 30
    }
  }
}
